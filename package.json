{
  "name": "multisend",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run artifacts && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test src scripts",
    "prepare:deploy": "bun run artifacts && bun scripts/prepare-deploy.ts",
    "test:contracts": "forge test -vv",
    "artifacts": "forge build && bun scripts/export-contract.ts",
    "deploy:web": "bun run build && wrangler pages deploy dist --project-name=multisend --branch=main"
  },
  "dependencies": {"viem": "^2.47.6"},
  "devDependencies": {"@eslint/js": "^9.39.1", "eslint": "^9.39.1", "globals": "^17.4.0", "typescript-eslint": "^8.56.1", "typescript": "^6.0.2", "vite": "^8.0.3", "wrangler": "^4.81.1", "@types/bun": "^1.3.0"}
}
